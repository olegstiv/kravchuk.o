@startuml
' Диаграмма классов ИС проектной организации (паттерн MVC)

class Отдел <<entity>> {
 -название_отдела : string
 -этаж : integer
 -телефон : string
 -начальник_отдела : string
 +__init__()
 + {static} показать_данные_отделов()
 + {static} добавить_данные_отдела()
 + {static} изменить_данные_отдела()
 + {static} удалить_данные_отдела()
}

class Сотрудник <<entity>> {
 -фио : string
 -должность : string
 -отдел : Отдел
 -пол : string
 -адрес : string
 -дата_рождения : Date
 +__init__()
 + {static} показать_данные_сотрудников()
 + {static} добавить_данные_сотрудника()
 + {static} изменить_данные_сотрудника()
 + {static} удалить_данные_сотрудника()
}

class Организация <<entity>> {
 -название_организации : string
 -тип_деятельности : string
 -страна : string
 -город : string
 -адрес : string
 -фио_директора : string
 +__init__()
 + {static} показать_данные_организаций()
 + {static} добавить_данные_организации()
 + {static} изменить_данные_организации()
 + {static} удалить_данные_организации()
}

class Договор <<entity>> {
 -номер_договора : integer
 -дата_заключения : Date
 -организация : Организация
 -стоимость : float
 +__init__()
 + {static} показать_данные_договоров()
 + {static} добавить_данные_договора()
 + {static} изменить_данные_договора()
 + {static} удалить_данные_договора()
}

class ПроектнаяРабота <<entity>> {
 -дата_начала : Date
 -дата_завершения : Date
 -договор : Договор
 -отдел : Отдел
 +__init__()
 + {static} показать_данные_работ()
 + {static} добавить_данные_работы()
 + {static} изменить_данные_работы()
 + {static} удалить_данные_работы()
}

class Вид <<boundary>> {
 -главное_окно
 -таблица
 -кнопка_добавить
 -кнопка_изменить
 -кнопка_удалить
 -поле_поиска
 + показать_окно_входа()
 + показать_меню()
 + показать_данные()
 + получить_данные()
 + показать_сообщение()
}

class Контроллер <<control>> {
 + запуск()
 + аутентификация()
 + показать_данные_отделов()
 + добавить_данные_отдела()
 + изменить_данные_отдела()
 + удалить_данные_отдела()
 + показать_данные_сотрудников()
 + добавить_данные_сотрудника()
 + изменить_данные_сотрудника()
 + удалить_данные_сотрудника()
 + показать_данные_организаций()
 + добавить_данные_организации()
 + изменить_данные_организации()
 + удалить_данные_организации()
 + показать_данные_договоров()
 + добавить_данные_договора()
 + изменить_данные_договора()
 + удалить_данные_договора()
 + показать_данные_работ()
 + добавить_данные_работы()
 + изменить_данные_работы()
 + удалить_данные_работы()
 + поиск()
 + управление_пользователями()
 + резервное_копирование()
}

Контроллер --> Вид
Контроллер --> Отдел
Контроллер --> Сотрудник
Контроллер --> Организация
Контроллер --> Договор
Контроллер --> ПроектнаяРабота

Отдел "1" -- "*" Сотрудник
Организация "1" -- "*" Договор
Договор "1" -- "*" ПроектнаяРабота
Отдел "1" -- "*" ПроектнаяРабота
@enduml
